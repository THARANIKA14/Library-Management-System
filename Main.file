
# Parent Class
class Library:
    def __init__(self):
        self.books = ["Python", "Java", "C++"]

    def display_books(self):
        print("\nAvailable Books:")
        for book in self.books:
            print(book)


# Child Class
class Student(Library):
    def __init__(self, name):
        super().__init__()
        self.name = name

    def borrow_book(self, book):
        if book in self.books:
            self.books.remove(book)
            print(self.name, "borrowed", book)
        else:
            print("Book is not available!")

    def return_book(self, book):
        self.books.append(book)
        print(self.name, "returned", book)


# Creating Object
student1 = Student("Tharanika")

# Menu
while True:
    print("\n--- LIBRARY MANAGEMENT SYSTEM ---")
    print("1. Display Books")
    print("2. Borrow Book")
    print("3. Return Book")
    print("4. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        student1.display_books()

    elif choice == "2":
        book = input("Enter book name: ")
        student1.borrow_book(book)

    elif choice == "3":
        book = input("Enter book name: ")
        student1.return_book(book)

    elif choice == "4":
        print("Thank you for using Library System!")
        break

    else:
        print("Invalid choice!")
